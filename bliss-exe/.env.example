# Copy to .env.local and fill in. Never commit .env.local.

# Sprout chat (Gemini) - https://aistudio.google.com/
GEMINI_API_KEY=

# Weather soundscapes in Nature.fm (ElevenLabs "Sound Effects" permission)
ELEVENLABS_API_KEY=

# Optional: where the Sprout agent listens for "send a text" requests.
# The defaults suit running the website and the agent on the same machine.
# SPROUT_NOTIFY_URL=http://127.0.0.1:8787/notify
# SPROUT_NOTIFY_SECRET=
