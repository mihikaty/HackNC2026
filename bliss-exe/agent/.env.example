PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Sprout replies (Gemini)
GEMINI_API_KEY=
# Optional: voice notes (ElevenLabs). Voice is skipped if the key is missing.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Set to "off" to disable voice notes.
SPROUT_VOICE=
# Set to "off" to stop transcribing voice notes people send Sprout.
SPROUT_VOICE_IN=

# Optional: texts from the website. Defaults suit one machine.
# SPROUT_NOTIFY_PORT=8787
# SPROUT_NOTIFY_SECRET=   (set the same value in ../.env.local)
