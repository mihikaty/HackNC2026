.touch-grass-app {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  width: 100%;
  max-width: 420px;
  min-height: 360px;
  padding: 24px;
  box-sizing: border-box;
  color: #164b52;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(213, 248, 239, 0.95)),
    #d5f8ef;
  border: 2px solid rgba(255, 255, 255, 0.9);
  border-radius: 24px;
  box-shadow:
    0 12px 30px rgba(20, 120, 135, 0.2),
    inset 0 0 0 1px rgba(64, 184, 186, 0.25),
    inset 0 2px 0 rgba(255, 255, 255, 0.95);
  font-family:
    "Trebuchet MS",
    "Segoe UI",
    sans-serif;
}

.touch-grass-app::before {
  position: absolute;
  z-index: -1;
  top: 0;
  left: 0;
  width: 100%;
  height: 45%;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.8),
    rgba(255, 255, 255, 0)
  );
  content: "";
  pointer-events: none;
}

.touch-grass-app__cloud {
  position: absolute;
  z-index: -1;
  width: 100px;
  height: 32px;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999px;
  filter: blur(1px);
  pointer-events: none;
}

.touch-grass-app__cloud::before,
.touch-grass-app__cloud::after {
  position: absolute;
  bottom: 0;
  background: inherit;
  border-radius: 50%;
  content: "";
}

.touch-grass-app__cloud::before {
  left: 18px;
  width: 42px;
  height: 42px;
}

.touch-grass-app__cloud::after {
  right: 16px;
  width: 52px;
  height: 52px;
}

.cloud-one {
  top: 34px;
  right: -30px;
  opacity: 0.65;
  transform: scale(0.75);
}

.cloud-two {
  top: 144px;
  left: -44px;
  opacity: 0.4;
  transform: scale(0.55);
}

.touch-grass-app__header {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.touch-grass-app__icon {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  background: linear-gradient(145deg, #eaffff, #8ce4cb);
  border: 2px solid rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  box-shadow:
    0 5px 10px rgba(17, 125, 129, 0.2),
    inset 0 2px 2px rgba(255, 255, 255, 0.9);
  font-size: 28px;
}

.touch-grass-app__eyebrow {
  margin: 0 0 3px;
  color: #3c9290;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.touch-grass-app h1 {
  margin: 0;
  color: #17666b;
  font-size: 1.6rem;
  letter-spacing: -0.04em;
  text-shadow: 0 1px 0 #ffffff;
}

.touch-grass-app__content {
  position: relative;
}

.touch-grass-app__status-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  color: #397f7e;
  font-size: 0.82rem;
  font-weight: 700;
}

.touch-grass-app__status-dot {
  width: 9px;
  height: 9px;
  background: #54d47a;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(58, 180, 117, 0.25);
}

.touch-grass-app__quest-card {
  padding: 20px;
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 18px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    0 6px 14px rgba(41, 143, 143, 0.1);
}

.touch-grass-app__quest-label {
  margin: 0 0 8px;
  color: #6a9c9a;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.touch-grass-app__quest-text {
  min-height: 58px;
  margin: 0 0 20px;
  color: #14545b;
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.3;
}

.touch-grass-app__empty-state {
  min-height: 58px;
  margin: 0 0 20px;
  color: #43827c;
  font-size: 1rem;
  font-style: italic;
  line-height: 1.5;
}

.touch-grass-app__complete-button {
  position: relative;
  display: block;
  overflow: hidden;
  width: 100%;
  padding: 13px 18px;
  color: #ffffff;
  background: linear-gradient(180deg, #66e5a0 0%, #26b879 52%, #159b6b 100%);
  border: 2px solid rgba(255, 255, 255, 0.9);
  border-radius: 999px;
  box-shadow:
    0 5px 0 #107f61,
    0 8px 14px rgba(20, 137, 106, 0.26),
    inset 0 2px 0 rgba(255, 255, 255, 0.75);
  cursor: pointer;
  font: inherit;
  font-weight: 700;
  text-shadow: 0 1px 2px rgba(0, 90, 65, 0.45);
  transition:
    transform 120ms ease,
    box-shadow 120ms ease,
    filter 120ms ease;
}

.touch-grass-app__complete-button:hover:not(:disabled) {
  filter: saturate(1.12) brightness(1.05);
  transform: translateY(-1px);
}

.touch-grass-app__complete-button:active:not(:disabled) {
  box-shadow:
    0 2px 0 #107f61,
    0 4px 8px rgba(20, 137, 106, 0.22),
    inset 0 2px 0 rgba(255, 255, 255, 0.65);
  transform: translateY(3px);
}

.touch-grass-app__complete-button:focus-visible {
  outline: 3px solid rgba(35, 144, 220, 0.65);
  outline-offset: 3px;
}

.touch-grass-app__complete-button:disabled {
  background: linear-gradient(180deg, #a7d9bd, #7dbd9d);
  box-shadow:
    0 4px 0 #659c83,
    inset 0 2px 0 rgba(255, 255, 255, 0.65);
  cursor: not-allowed;
  opacity: 0.9;
}

.touch-grass-app__button-shine {
  position: absolute;
  top: 4px;
  left: 12%;
  width: 76%;
  height: 38%;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 999px;
  pointer-events: none;
}

.touch-grass-app__score-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18px;
  padding: 12px 15px;
  background: rgba(255, 255, 255, 0.48);
  border: 1px solid rgba(120, 201, 190, 0.35);
  border-radius: 13px;
}

.touch-grass-app__score-label {
  color: #558d89;
  font-size: 0.85rem;
  font-weight: 700;
}

.touch-grass-app__score-value {
  color: #168d70;
  font-size: 1.25rem;
}